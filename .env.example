# Backend
DB_URL=jdbc:postgresql://localhost:5432/mvp_propostas
DB_USERNAME=mvp
DB_PASSWORD=mvp
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4300,http://127.0.0.1:4300,http://localhost:4400,http://127.0.0.1:4400
# E-mails Firebase com acesso ao painel admin (vírgula). Vazio = ninguém é admin.
# Antes de produção: substituir por custom claim admin: true no Firebase.
ADMIN_EMAILS=

# Homologação/produção: false remove o usuário demo do Flyway V3/V4 na subida.
KEEP_DEMO_SEED=true
APP_REQUIRE_EMAIL_VERIFIED=true
SPRINGDOC_ENABLED=true
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Sentry (conta pessoal de desenvolvimento)
# Frontend: projeto javascript-angular
# Backend: projeto mvp-propostas-api
SENTRY_DSN=https://419cfa37be287d043be5e6014e36a626@o4504449191313408.ingest.us.sentry.io/4511957041414144
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
APP_DEBUG_SENTRY_TEST_ENABLED=false
# Só local: rota /api/v1/dev/mercadopago/oauth
APP_DEBUG_MP_OAUTH_ENABLED=true

# Firebase (validação do ID token na API)
FIREBASE_PROJECT_ID=gestao-propostas-mvp

# Mercado Pago (checkout Pro — assinaturas)
# Aplicação GestaoPropostas — https://www.mercadopago.com.br/developers/panel/app/4673848288729614
# Use o Access Token de teste (sandbox) em desenvolvimento. Não commitar o valor real.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_APPLICATION_ID=4673848288729614
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PRO_PLAN_ID=
# HTTPS público, sem localhost e sem query string. Em produção: https://seu-dominio.com/profile
MERCADOPAGO_BACK_URL=https://www.mercadopago.com.br
# Homologação isolada (sem conta real no checkout):
# O token TEST- do painel pertence à sua conta REAL como vendedor, e o Mercado Pago exige
# que pagador e recebedor sejam ambos reais ou ambos de teste. Por isso o checkout de
# homologação usa um token cujo vendedor é uma conta de teste:
# 1. Crie contas Vendedor + Comprador em Developers → GestaoPropostas → Contas de teste
# 2. Faça login em mercadopago.com.br com o usuário/senha do VENDEDOR de teste
# 3. Nesse login, crie uma aplicação (Pagamentos online → Assinaturas)
# 4. Copie o Access Token em Credenciais de produção (é sandbox, pois a conta é de teste)
MERCADOPAGO_SANDBOX_ACCESS_TOKEN=
# User ID do COMPRADOR de teste; o backend resolve o e-mail pelo nickname da conta
MERCADOPAGO_TEST_PAYER_USER_ID=
# Opcional: e-mail @testuser.com explícito (tem prioridade sobre o User ID)
MERCADOPAGO_TEST_PAYER_EMAIL=
# OAuth do vendedor de teste (alternativa ao passo 2, exige Client Secret ativado)
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/dev/mercadopago/oauth/callback
# URL pública do backend para webhooks (ex.: ngrok em dev)
MERCADOPAGO_WEBHOOK_URL=
